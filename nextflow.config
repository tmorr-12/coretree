manifest {
    name = 'coretree'
    author = 'Tom Morrison'
    description = 'Simple prokaryotic core genome phylogeny workflow written in Nextflow'
    version = '0.0.1'
    nextflowVersion = '>=26.04.6'
}

params {
    outdir = "./results"
    help = false
    publish_dir_mode = 'copy'
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

dag {
    enabled = true
    file = "${params.outdir}/pipeline-info/pipeline_dag.mmd"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline-info/execution_trace_${new Date().format('yyyyMMdd_HHmmss')}.txt"
}

profiles {
    standard {
        process {
            executor = 'local'
            withName: 'PANAROO' { cpus = 32 }
            withName: 'SNP_SITES' { cpus = 1 }
            withName: 'IQTREE' { cpus = 96 }
        }
        singularity {
            enabled = true
            autoMounts = true
            cacheDir = "/pub63/tom22/singularity_cache"
        }
    }
    laptop {
        process {
            executor = 'local'
            withName: 'PANAROO' { cpus = 8 }
            withName: 'SNP_SITES' { cpus = 1 }
            withName: 'IQTREE' { cpus = 8 }
        }
        docker {
            enabled = true
        }
    }
}
